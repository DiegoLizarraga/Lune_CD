# ─── SECRETOS Y DATOS PERSONALES (¡NUNCA SUBIR!) ────────────────
# datos.json lleva las API keys y el token de Telegram.
# Plantilla versionada: datos.example.json (datos.py la copia al arrancar).
datos.json
api_keys.json
.env
.env.local

# Preferencias locales de la app
config.json
# Copias de un config.json roto que aparta nucleo/config.py (mismos datos
# personales) y el temporal de su escritura atómica
config.json.corrupto-*
.config.json.*.tmp

# Alarmas y temporizadores del usuario (nucleo/alarmas.py), las copias de un
# alarmas.json roto y el temporal de su escritura atómica
alarmas.json
alarmas.json.corrupto-*
.alarmas.json.*.tmp

# Memoria personal del usuario (y el temporal de su escritura atómica)
memoria.json
.memoria.json.*.tmp
telegram-bot-or/data/

# Registro del instalador (rutas de tu equipo)
instalacion.log

